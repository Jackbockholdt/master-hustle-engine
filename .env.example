# ===================================================================
# MASTER HUSTLE ENGINE & ANTIGRAVITY TOKEN ROUTER - ENVIRONMENT CONFIG
# Turn-Key All-in-One Deployment Config Template
# ===================================================================

# Server Environment & Port (Render standard is 10000)
PORT=10000
NODE_ENV=production
APP_URL=https://master-hustle-engine.onrender.com

# Primary AI Layer & API Credentials
# Google AI Studio / Gemini API (Gemini 1.5 Flash & Gemini 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FLAGSHIP_MODEL=gemini-1.5-pro

# Anthropic Claude API (Optional Fallback / Reasoning Layer)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Project Isolated Integrations
# 1. Self-Cleaning Shovel Invention (missedcallproject.com)
SHOVEL_WEBHOOK_URL=https://missedcallproject.com/api/v1/webhook
SHOVEL_API_SECRET=your_shovel_secret_key

# 2. THCA Review Site (jacksplugreviews.com - Hostinger / WP)
WP_API_URL=https://jacksplugreviews.com/wp-json/wp/v2
WP_APP_PASSWORD=your_wordpress_application_password

# Stripe Payment & Monetization Integration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_default_checkout_link
STRIPE_STARTER_LINK=https://buy.stripe.com/your_starter_tier_link
STRIPE_GROWTH_LINK=https://buy.stripe.com/your_growth_tier_link
STRIPE_BUYOUT_LINK=https://buy.stripe.com/your_buyout_tier_link

# Security & Webhook Signature
WEBHOOK_SECRET=your_master_webhook_secret_key
GUMLOOP_API_KEY=your_gumloop_api_key_here
GUMLOOP_WEBHOOK_SECRET=your_gumloop_webhook_secret

# Mail Transport Relay (Google Apps Script / SMTP)
GMAIL_HTTP_URL=https://script.google.com/macros/s/your_script_id/exec
GMAIL_HTTP_KEY=your_relay_auth_key
