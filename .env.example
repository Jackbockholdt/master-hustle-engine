# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Values here are documentation only; leave real keys out of this file.
#
# The server audits these at startup and prints exactly what is missing.
# Check the running config any time with: curl http://localhost:3005/health

PORT=3005

# ── CRITICAL: AI generation (all 9 skills + pitch/follow-up copy) ─────────────
# Missing → generation endpoints error, cron and lead batches skip their runs.
GEMINI_API_KEY=

# ── CRITICAL: Payments ────────────────────────────────────────────────────────
# Missing → /api/stripe-webhook returns 503; the rest of the engine stays up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout links used in sales copy and cold email pitches.
STRIPE_PAYMENT_LINK=
STRIPE_SETUP_LINK=
STRIPE_RETAINER_LINK=

# ── CRITICAL: Admin notifications ─────────────────────────────────────────────
# Missing → alerts, purchase notices, and the daily digest log to stdout only.
ADMIN_EMAIL=

# ── Admin surface ─────────────────────────────────────────────────────────────
# Required. Without it every /admin and /api/admin route returns 503 (fail closed),
# not open. Set this in Render BEFORE deploying the commit that adds the gate,
# or you will lock yourself out of admin.
# Generate with: openssl rand -hex 32
# Send as X-Admin-Key, Authorization: Bearer <key>, or ?key= (query lands in
# access logs, browser history, and Referer — prefer the header).
ADMIN_KEY=

# ── CRITICAL: Mailer — set the relay OR the SMTP block, not necessarily both ──
# Gmail HTTPS relay (Apps Script) is the send path that works on Render, which
# blocks outbound SMTP. Missing both → all outbound sends are suppressed and
# queued follow-ups stay pending instead of being marked failed.
GMAIL_HTTP_URL=
GMAIL_HTTP_KEY=

# SMTP fallback — local dev only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional sender identity. FROM_EMAIL must be a verified "Send mail as" alias
# on the relay's Google account or Gmail silently rewrites it.
FROM_EMAIL=
FROM_NAME=Jack Bockholdt

# ── Cold-outbound kill switch ────────────────────────────────────────────────
# DEFAULT IS PAUSED. Cold pitches and their follow-ups only send when this is an
# explicit false. Leave it unset (or set to anything else) and the engine still
# boots, still ingests and queues leads, still takes Stripe webhooks, and still
# sends transactional mail — admin alerts, purchase notices, the buyer welcome
# email, and the daily status digest. It just does not cold-email anyone.
# Flip to false only when you actually intend to send.
OUTBOUND_PAUSED=true
# Optional one-line note shown in /health, the admin form, and the daily digest.
OUTBOUND_PAUSE_REASON=Sender reputation hold — resume with researched lists only.

# ── Outbound pacing (safe defaults applied if unset) ──────────────────────────
# Shared daily cap across ALL campaigns — pitches and follow-ups combined.
# 4 is the warming cap for a new sending account. Raise it only after two weeks
# of clean sending, and ramp gradually. Overflow stays queued, never dropped.
DAILY_SEND_CAP=4
BATCH_INTERVAL_HOURS=6
BATCH_SIZE=4

# ── Daily engine status digest to ADMIN_EMAIL ────────────────────────────────
# 5-field cron in UTC. Set STATUS_EMAIL_ENABLED=false to turn the digest off.
STATUS_EMAIL_CRON=0 7 * * *
STATUS_EMAIL_ENABLED=true

# ── Offer identity ────────────────────────────────────────────────────────────
# PRICE IS NOT SET HERE. config/pricing.json is the single pricing authority.
INVENTION_NAME=White-Label Agency AI Infrastructure
INVENTION_SUMMARY=
INVENTOR_NAME=
INVENTOR_EMAIL=
PROOF_URL=
TARGET_INDUSTRIES=digital marketing agency,lead generation agency,marketing agency,seo agency,ppc agency,social media agency,growth agency,advertising agency

# Marketing link at the bottom of emails
PS_LINK=https://jacksplugreviews.com

# ── Lead source: Outscraper direct (Gumloop is retired — paid-plan-only since 2026-09-01) ──
# Key from https://app.outscraper.com/profile. Without it, leads only arrive via
# POST /admin/leads (tools/load-leads.js) or POST /webhook/lead.
OUTSCRAPER_API_KEY=
# '|'-separated Google Maps queries (commas live INSIDE a query, so they are not the separator).
OUTSCRAPER_QUERIES=digital marketing agency, Austin, TX|seo agency, Denver, CO|ppc agency, Nashville, TN
# Places per query per run. Each place with email enrichment costs credits — start small.
OUTSCRAPER_LIMIT_PER_QUERY=20
# Auto-run cadence in hours. 0 = manual only (POST /admin/scrape-now).
OUTSCRAPER_INTERVAL_HOURS=24
# Run Outscraper's deliverability check and keep only RECEIVING addresses.
OUTSCRAPER_VALIDATE_EMAILS=true
OUTSCRAPER_ACCEPT_STATUSES=RECEIVING
# Skip auto-runs while this many leads are already pending.
OUTSCRAPER_MAX_QUEUE=200
# Google Maps publishes role inboxes (info@, hello@, contact@) far more often than
# named addresses, and screenLeadQuality() rejects those by default. Left false, a
# Maps-sourced scrape queues close to nothing. Set true to accept them — they are
# legitimate for small businesses, just lower priority than a real person.
ALLOW_ROLE_MAILBOXES=false

# ── Cold-email checkout link (default OFF — raw Stripe links in cold mail hurt deliverability) ──
PITCH_INCLUDE_CHECKOUT_LINK=false
# LOCAL TESTING ONLY: accept unsigned Stripe webhook events when STRIPE_WEBHOOK_SECRET is unset.
# Never true on Render.
STRIPE_ALLOW_UNSIGNED_TEST_EVENTS=false