PORT=3000
GEMINI_API_KEY=your_google_gemini_key

# SMTP Credentials (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jackbockholdt88@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# Gmail HTTPS relay (Apps Script) — the send path that actually works on Render
# (Render blocks outbound SMTP; the SMTP_* vars above are a local-dev fallback only)
GMAIL_HTTP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GMAIL_HTTP_KEY=your_relay_shared_secret

# Shared daily outbound-email cap across ALL campaigns (pitches + follow-ups)
DAILY_SEND_CAP=50

# Admin Failure Notification
ADMIN_EMAIL=jackbockholdt88@gmail.com

# Daily engine status email (health digest to ADMIN_EMAIL).
# STATUS_EMAIL_CRON is a 5-field cron in UTC (default 07:00 UTC).
# Set STATUS_EMAIL_ENABLED=false to turn the daily digest off.
STATUS_EMAIL_CRON=0 7 * * *
STATUS_EMAIL_ENABLED=true

# Marketing link at bottom of emails
PS_LINK=https://jacksplugreviews.com

# Automatic customer onboarding (sent on a successful Stripe payment via /api/stripe-webhook).
# Env changes need a fresh Render deploy to take effect.
# ONBOARDING_ACCESS_URL — access link shown in the onboarding email (defaults to PROOF_URL).
# ONBOARDING_VIDEO_URL  — onboarding video link (placeholder default; replace with the real one).
# SUPPORT_EMAIL / SUPPORT_NAME — support contact in the onboarding email (default ADMIN_EMAIL / FROM_NAME).
ONBOARDING_ACCESS_URL=https://master-hustle-engine.onrender.com/pitch
ONBOARDING_VIDEO_URL=https://your-onboarding-video-link.example.com
SUPPORT_EMAIL=jackbockholdt88@gmail.com
SUPPORT_NAME=Jack Bockholdt
