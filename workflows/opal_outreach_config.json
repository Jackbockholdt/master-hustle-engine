{
  "system": "Master Hustle Engine & Antigravity Single-Source Token Router",
  "environment": "Gemini Opal / AI Studio Production Pipeline",
  "version": "4.1.0",
  "optimization": {
    "token_reduction_target_pct": 87.6,
    "standard_tokens_per_lead": 2500,
    "optimized_tokens_per_lead": 310,
    "daily_batch_limit": 25
  },
  "pipeline_routing_rules": [
    {
      "tier": 1,
      "name": "ICP Fast Qualifier",
      "model": "gemini-1.5-flash",
      "eval_conditions": {
        "required_fields": ["company_name"],
        "contact_fields": ["email", "phone"],
        "target_industries": ["B2B SaaS", "E-commerce", "Plumbing & Trades", "Legal Services", "Digital Marketing Agency", "Healthcare"]
      },
      "action_if_pass": "proceed_to_tier_2",
      "action_if_fail": "drop_and_log"
    },
    {
      "tier": 2,
      "name": "Deep Researcher & Hook Extractor",
      "model": "gemini-1.5-flash",
      "extract_fields": ["core_value_prop", "pain_point", "hook"],
      "action": "proceed_to_tier_3"
    },
    {
      "tier": 3,
      "name": "High-Converting Copywriter",
      "model": "grok-beta",
      "outputs": ["subject_line", "email_body", "sms_body"],
      "dispatch_targets": ["email_smtp", "sms_gateway", "webhook_endpoint"]
    }
  ],
  "flagship_access_control": {
    "flagship_model": "gemini-1.5-pro",
    "access": "STRICTLY_HUMAN_TRIGGERED_ONLY",
    "header_required": "X-Human-Trigger: true",
    "body_param_required": "humanTriggered: true",
    "unauthorized_error": "ERR_FLAGSHIP_RESTRICTED_TO_HUMAN",
    "unauthorized_http_status": 403
  },
  "webhook_payload_mapping": {
    "company_name": "company",
    "contact_name": "contact_first_name",
    "email": "work_email",
    "phone": "direct_phone",
    "website": "domain_url",
    "industry": "category",
    "website_text": "scraped_body_text"
  },
  "endpoints": {
    "local_gateway": "http://localhost:3005",
    "model_router": "http://localhost:3005/api/model/route",
    "lead_webhook": "http://localhost:3005/webhook/lead",
    "batch_runner": "http://localhost:3005/api/run-25-batch",
    "health_check": "http://localhost:3005/api/health"
  }
}
